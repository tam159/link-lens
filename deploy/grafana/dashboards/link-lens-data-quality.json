      "type": "stat",
      "title": "Longest wait, days",
      "description": "Blocked by drift: the approved mapping cannot read the source's latest snapshot, and a person must review a new one.",
      "datasource": {
        "type": "postgres",
        "uid": "linklens-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "linklens-analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(round(max(extract(epoch FROM now() - waiting_since) / 86400)::numeric, 1), 0) FROM analytics.source_health WHERE waiting_for_review"
