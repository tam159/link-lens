          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT source_title, records, observations, concepts_used, mapped_fields, unmapped_fields, unmapped_share, okf_path, source_id FROM analytics.source_coverage ORDER BY observations DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
