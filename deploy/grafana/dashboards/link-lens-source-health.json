{
  "uid": "link-lens-source-health",
  "title": "Source health",
  "description": "Which sources are stale, never checked or waiting for a person, and how onboarding runs went.",
  "tags": [
    "link-lens"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 0,
  "refresh": "",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "link-lens"
      ],
      "title": "Link Lens dashboards",
      "asDropdown": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "product_url",
        "label": "Product service",
        "type": "textbox",
        "query": "http://localhost:8100",
        "current": {
          "text": "http://localhost:8100",
          "value": "http://localhost:8100"
        },
        "hide": 0,
        "options": [
          {
            "selected": true,
            "text": "http://localhost:8100",
            "value": "http://localhost:8100"
          }
        ]
      },
      {
        "name": "dagster_url",
        "label": "Dagster",
        "type": "textbox",
        "query": "http://localhost:3070",
        "current": {
          "text": "http://localhost:3070",
          "value": "http://localhost:3070"
        },
        "hide": 0,
        "options": [
          {
            "selected": true,
            "text": "http://localhost:3070",
            "value": "http://localhost:3070"
          }
        ]
      },
      {
        "name": "inbox_url",
        "label": "Agent Inbox",
        "type": "textbox",
        "query": "http://localhost:3000",
        "current": {
          "text": "http://localhost:3000",
          "value": "http://localhost:3000"
        },
        "hide": 0,
        "options": [
          {
            "selected": true,
            "text": "http://localhost:3000",
            "value": "http://localhost:3000"
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**Which sources need attention, and why.** A source is *stale* when a check is overdue against its cadence, and has *no cadence* until someone sets one (`link-lens source cadence SOURCE --days N`). A source *waiting for review* has a mapping in the Agent Inbox. Drift against the approved mapping is checked by `link-lens source drift` and is not stored yet, so it is not shown."
      }
    },
    {
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "type": "stat",
      "title": "Registered sources",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "linklens-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "linklens-analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) FROM analytics.source_health WHERE true"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "type": "stat",
      "title": "Fresh",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "linklens-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "linklens-analytics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) FROM analytics.source_health WHERE refresh_status = 'fresh'"
        }
      ],
      "fieldConfig": {
