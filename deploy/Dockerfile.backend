FROM ghcr.io/astral-sh/uv:0.7.16 AS uv
FROM python:3.13-slim
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/opt/venv PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev
COPY firmable_ontology.yaml alembic.ini langgraph.json ./
COPY migrations ./migrations
RUN mkdir -p /app/artifacts /app/.langgraph_api && useradd -u 1000 -m app && chown -R app:app /app
USER app
CMD ["sh", "-c", "alembic upgrade head && langgraph dev --host 0.0.0.0 --port 2024 --no-browser --no-reload --allow-blocking"]
