FROM ghcr.io/astral-sh/uv:0.7.16 AS uv
FROM python:3.13-slim
COPY --from=uv /uv /usr/local/bin/uv
RUN uv venv /opt/venv && uv pip install --python /opt/venv/bin/python pandas==3.0.5 openpyxl==3.1.5 pypdf==6.19.0 pyyaml==6.0.3
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1
RUN useradd -u 1000 -m analyst
USER analyst
WORKDIR /work
CMD ["python", "-c", "print('Link Lens sandbox image ready')"]
