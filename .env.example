# Copy to .env and fill required keys for live inference. Never commit .env.
# Saved outputs and deterministic tests need no provider credentials.

# REQUIRED for Part 1: OpenRouter key with access to the Jev Decisions API.
OPENROUTER_API_KEY=
LINK_LENS_TRIAGE_MODEL=typesafe/jev-1.13

# REQUIRED for Part 2 and smoke-model: endpoint and matching key.
# Use your Azure/OpenAI-compatible v1 base URL, not a deployment-specific URL.
OPENAI_API_BASE=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
OPENAI_API_KEY=
# Must match a model/deployment accessible through the endpoint above.
LINK_LENS_MODEL=gpt-6-luna

# OPTIONAL: LangSmith tracing. Leave disabled without a LangSmith key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=link-lens

# Experiment scope. Choose a new value BEFORE a separate end-to-end rerun;
# recreate the backend so CLI and server use the same experiment/model settings.
LINK_LENS_EXPERIMENT_ID=jev-gpt6-luna-ontology-v1

# Local CLI addresses. Compose supplies container-specific equivalents.
LINK_LENS_DATABASE_URL=postgresql+psycopg://linklens:linklens@localhost:5439/linklens
LINK_LENS_API_URL=http://localhost:2024
LINK_LENS_ARTIFACT_DIR=artifacts
# OPTIONAL: keep new artifact bytes in an S3-compatible bucket instead of the
# directory above (needs `uv sync --group s3`; credentials from the standard AWS
# environment). Artifacts already stored locally stay readable.
# LINK_LENS_ARTIFACT_STORE=s3
# LINK_LENS_ARTIFACT_BUCKET=YOUR-BUCKET
# LINK_LENS_ARTIFACT_PREFIX=link-lens
# LINK_LENS_ARTIFACT_ENDPOINT_URL=https://YOUR-S3-ENDPOINT

# Host names the MCP endpoints of the product service answer to, as a JSON list.
# Leave unset when a proxy in front checks the Host header.
# LINK_LENS_MCP_ALLOWED_HOSTS=["data.example.com"]

# OPTIONAL: the product service in production. It authenticates, limits and
# counts on the primary and reads data from the replica. Each is a login that is
# only a member of the linklens_product role. Unset, it uses DATABASE_URL.
# LINK_LENS_PRODUCT_DATABASE_URL=postgresql+psycopg://PRODUCT_LOGIN:PASSWORD@PRIMARY-HOST:5432/linklens
# LINK_LENS_PRODUCT_REPLICA_URL=postgresql+psycopg://PRODUCT_LOGIN:PASSWORD@REPLICA-HOST:5432/linklens
# Where each key's rate bucket is kept: database (any number of instances) or
# memory (one instance only).
# LINK_LENS_RATE_LIMIT_STORE=database
# A long random value that signs bundle download links served by the product
# service; every instance needs the same one. Not needed when bundles are in S3.
# LINK_LENS_LINK_SECRET=REPLACE-WITH-A-LONG-RANDOM-VALUE
# LINK_LENS_LINK_TTL_SECONDS=300
# /metrics answers only to this bearer token; unset, there is no /metrics.
# LINK_LENS_METRICS_TOKEN=REPLACE-WITH-A-LONG-RANDOM-VALUE
LINK_LENS_SANDBOX_URL=http://localhost:8091
LINK_LENS_SANDBOX_TOKEN=local-development-only
# If changing this on initial setup, update the password in DATABASE_URL too.
LINK_LENS_POSTGRES_PASSWORD=linklens

# OPTIONAL: Dagster and dbt (`docker compose --profile orchestration up -d`).
# Dagster keeps its own storage in a `dagster` database on the same server; this
# is the password of the `dagster` login that owns it, set when it is created.
# LINK_LENS_DAGSTER_POSTGRES_PASSWORD=dagster
# Only for the deployment override (deploy/compose.deploy.yaml): the password of
# the login the Dagster services use on the application's database. That login
# can only become the orchestrator's and dbt's roles. With the override,
# LINK_LENS_DAGSTER_POSTGRES_PASSWORD above is required too.
# LINK_LENS_ORCHESTRATION_PASSWORD=
# OPTIONAL: where alerts go. An incoming-webhook URL that accepts {"text": ...},
# as Slack's and most chat tools' do. It is a secret. Unset, alerts are logged
# and not sent. The two addresses are used in alert links.
# LINK_LENS_ALERT_WEBHOOK_URL=
# LINK_LENS_DAGSTER_URL=http://localhost:3070
# LINK_LENS_INBOX_URL=http://localhost:3000
# OPTIONAL: the operations console (`docker compose --profile console up -d admin`,
# http://localhost:8200). Who may sign in, as one line of JSON: token -> name and
# role (engineer, product_owner or admin). A token is a secret: use long random
# ones, one per person. Unset, nobody can sign in. For development and one
# machine; there is no identity provider.
# LINK_LENS_ADMIN_USERS={"REPLACE_WITH_A_LONG_RANDOM_TOKEN":{"name":"Your Name","role":"admin"}}
# Addresses the console links to, besides the two above.
# LINK_LENS_DASHBOARDS_URL=http://localhost:3080
# LINK_LENS_PRODUCT_URL=http://localhost:8100
# OPTIONAL: backups on a timer (`docker compose --profile backups up -d backup`).
# The folder the daily dumps of both databases go to. Dumps of `linklens` are
# never deleted (about 130 MB each); Dagster's are kept for the number of days below.
# LINK_LENS_BACKUP_DIR=/path/to/backups
# LINK_LENS_DAGSTER_BACKUP_DAYS=7
# OPTIONAL: Grafana (`docker compose --profile dashboards up -d`), the password
# of its `admin` user and of the `linklens_grafana` database login it reads the
# reporting models with. Both are set when first created.
# LINK_LENS_GRAFANA_ADMIN_PASSWORD=admin
# LINK_LENS_GRAFANA_POSTGRES_PASSWORD=grafana
# `uv run link-lens dbt ...` takes dbt's connection from LINK_LENS_DATABASE_URL.
# dbt run directly from transform/ reads these instead; unset, they are the
# local Compose database, with LINK_LENS_POSTGRES_PASSWORD as the password.
# LINK_LENS_DBT_HOST=localhost
# LINK_LENS_DBT_PORT=5439
# LINK_LENS_DBT_USER=linklens
# LINK_LENS_DBT_PASSWORD=
# LINK_LENS_DBT_DATABASE=linklens

# Per-onboarding-run model-call and cumulative token limits.
LINK_LENS_MAX_MODEL_CALLS=50
LINK_LENS_MAX_PYTHON_CALLS=10
LINK_LENS_MAX_INPUT_TOKENS=9000000
LINK_LENS_MAX_OUTPUT_TOKENS=2000000
LINK_LENS_MAPPING_MAX_OUTPUT_TOKENS=16000

# Shared experiment budget across triage, ontology, onboarding and enhancement.
# Failed/unknown attempts retain reservations. Token/call/time limits also apply.
LINK_LENS_MAX_COST_USD=10
# Optional explicit rate overrides for a deployment (USD per million tokens).
# LINK_LENS_INPUT_USD_PER_MILLION=0.20
# LINK_LENS_OUTPUT_USD_PER_MILLION=1.20
# LINK_LENS_PRICING_BASIS=Your deployment rate card, date and currency

# OPTIONAL experimental post-approval batch enhancement (paid model calls).
# The default assemble command remains exact-identifier only.
LINK_LENS_RESOLUTION_MODEL=typesafe/jev-1.13
LINK_LENS_EMBEDDING_MODEL=text-embedding-3-small
LINK_LENS_ENHANCEMENT_MAX_COST_USD=10
LINK_LENS_ENHANCEMENT_WORKERS=6
LINK_LENS_ENHANCEMENT_RETRIES=2
# Maximum new identity pairs per invocation; cached decisions do not count.
LINK_LENS_ENHANCEMENT_MAX_PAIRS=500
LINK_LENS_EMBEDDING_BATCH_SIZE=64
# Embeddings use OPENAI_API_BASE / OPENAI_API_KEY unless overridden here.
# Configure both overrides together when using a separate provider.
# LINK_LENS_EMBEDDING_API_BASE=https://api.openai.com/v1
# LINK_LENS_EMBEDDING_API_KEY=YOUR_EMBEDDING_PROVIDER_KEY

# Set 1.1 when your provider endpoint applies a 10% regional uplift.
LINK_LENS_PRICING_MULTIPLIER=1.0
