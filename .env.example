# Copy to .env and fill required keys for live inference. Never commit .env.
# Saved outputs and deterministic tests need no provider credentials.

# REQUIRED for Part 1: OpenRouter key with access to the Jev Decisions API.
OPENROUTER_API_KEY=
LINK_LENS_TRIAGE_MODEL=typesafe/jev-1.13

# REQUIRED for Part 2 and smoke-model: endpoint and matching key.
# Use your Azure/OpenAI-compatible v1 base URL, not a deployment-specific URL.
OPENAI_API_BASE=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
OPENAI_API_KEY=
# Must match a model/deployment accessible through the endpoint above.
LINK_LENS_MODEL=gpt-5.6-luna

# OPTIONAL: LangSmith tracing. Leave disabled without a LangSmith key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=link-lens

# Experiment scope. Choose a new value BEFORE a separate end-to-end rerun;
# recreate the backend so CLI and server use the same experiment/model settings.
LINK_LENS_EXPERIMENT_ID=jev-luna-v1

# Local CLI addresses. Compose supplies container-specific equivalents.
LINK_LENS_DATABASE_URL=postgresql+psycopg://linklens:linklens@localhost:5439/linklens
LINK_LENS_API_URL=http://localhost:2024
LINK_LENS_ARTIFACT_DIR=artifacts
LINK_LENS_SANDBOX_URL=http://localhost:8091
LINK_LENS_SANDBOX_TOKEN=local-development-only
# If changing this on initial setup, update the password in DATABASE_URL too.
LINK_LENS_POSTGRES_PASSWORD=linklens

# Per-onboarding-run model-call and cumulative token limits.
LINK_LENS_MAX_MODEL_CALLS=50
LINK_LENS_MAX_PYTHON_CALLS=10
LINK_LENS_MAX_INPUT_TOKENS=9000000
LINK_LENS_MAX_OUTPUT_TOKENS=2000000

# Per-onboarding-attempt dollar budget; supported models use saved published rates.
# This is not a global project spend cap. Token/call/time limits also apply.
LINK_LENS_MAX_COST_USD=10
# Optional explicit rate overrides for a deployment (USD per million tokens).
# LINK_LENS_INPUT_USD_PER_MILLION=0.20
# LINK_LENS_OUTPUT_USD_PER_MILLION=1.20
# LINK_LENS_PRICING_BASIS=Your deployment rate card, date and currency

# OPTIONAL experimental post-approval batch enhancement (paid model calls).
# The default assemble command remains exact-identifier only.
LINK_LENS_RESOLUTION_MODEL=typesafe/jev-1.13
LINK_LENS_EMBEDDING_MODEL=text-embedding-3-small
LINK_LENS_ENHANCEMENT_MAX_COST_USD=10
LINK_LENS_ENHANCEMENT_WORKERS=6
LINK_LENS_ENHANCEMENT_RETRIES=2
# Maximum new identity pairs per invocation; cached decisions do not count.
LINK_LENS_ENHANCEMENT_MAX_PAIRS=500
LINK_LENS_EMBEDDING_BATCH_SIZE=64
# Embeddings use OPENAI_API_BASE / OPENAI_API_KEY unless overridden here.
# Configure both overrides together when using a separate provider.
# LINK_LENS_EMBEDDING_API_BASE=https://api.openai.com/v1
# LINK_LENS_EMBEDDING_API_KEY=YOUR_EMBEDDING_PROVIDER_KEY
